# === Claude Code ===
# Local per-machine settings — may contain local permissions / credentials.
# Shared settings (settings.json) and skills (skills/) ARE committed.
.claude/settings.local.json

# === Python ===
__pycache__/
*.py[cod]

# === spec-kit ===
# .specify/ and specs/ are the spec source-of-truth — DO commit them.

# === reference ===
# arthas 上游源码为 clone 的第三方仓库（约 94M，含内嵌 .git），不纳入版本控制；
# 仅提交我们产出的研究文档 reference/arthas-docs/。
reference/arthas/
# k3s 离线资源：大二进制不入库（~250MB），由 reference/k3s/fetch.sh 按需预置（003 测试床）
reference/k3s/k3s
reference/k3s/k3s-airgap-images-amd64.tar.gz

# === K8S 测试床凭证（cluster-admin，敏感，仅本机受控内网用） ===
test-env/k8s/kubeconfig/

# === Java / Maven ===
target/
build/
*.class
*.jar
# 例外：arthas-boot.jar 是静态诊断工具文件（非构建产物 / 非依赖），T009 夹具与 failsafe IT 依赖之；
# 需纳入版本控制，供 CI / 全新 clone 直接可用（不靠桩、不靠网络拉取）。
!tools/arthas-boot.jar
*.war
*.ear
*.hprof
.gradle/

# === 本地敏感配置（覆盖示例模板的本地真实值） ===
config/backends-local.yaml
config/backends.*.local.yaml

# === K8S Host 配置（006）：含 SSH 凭证（portal AES-GCM 加密），不入库；缺文件时 application.yml 内联回退（005 兼容） ===
config/k8s-hosts.yaml
config/k8s-hosts-local.yaml

# === 运行时动态配置（SmokeDemoLauncher 每次启动按动态端口重写，不入库） ===
config/backends-runtime.yaml

# === IDE 元数据 ===
.idea/
*.iml
.vscode/
*.swp
*.tmp

# === 日志 / 系统杂项 ===
*.log
logs/
.DS_Store
Thumbs.db

# === codebase-memory-mcp ===
# 索引产物：本地知识图谱快照，按需重建，不入库（团队成员各自 index_repository）。
.codebase-memory/

# === Node / 前端（004 portal web/） ===
# node_modules 与 frontend-maven-plugin 下载的 node 运行时不入库（CI 各自 npm install）
web/node_modules/
web/node/
web/.npm/
web/dist/

# === Playwright MCP（浏览器自动化工具的本地页面快照，不入库） ===
.playwright-mcp/
